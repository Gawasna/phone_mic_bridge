<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Honest Design Technical Light Theme Palette (SSOT: SPEC-005, OPS-002, CLAIM-001) -->
    <Color x:Key="ColorBackground">#F8F9FA</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorPanel">#F3F4F6</Color>
    <Color x:Key="ColorBorder">#D1D5DB</Color>
    <Color x:Key="ColorBorderSubtle">#E5E7EB</Color>
    <Color x:Key="ColorBorderDark">#9CA3AF</Color>

    <Color x:Key="ColorTextPrimary">#111827</Color>
    <Color x:Key="ColorTextSecondary">#374151</Color>
    <Color x:Key="ColorTextMuted">#6B7280</Color>
    <Color x:Key="ColorTextDisabled">#9CA3AF</Color>

    <!-- Technical Status Colors -->
    <Color x:Key="ColorPassBg">#DCFCE7</Color>
    <Color x:Key="ColorPassFg">#15803D</Color>
    <Color x:Key="ColorPassBorder">#86EFAC</Color>

    <Color x:Key="ColorFailBg">#FEE2E2</Color>
    <Color x:Key="ColorFailFg">#B91C1C</Color>
    <Color x:Key="ColorFailBorder">#FCA5A5</Color>

    <Color x:Key="ColorUnknownBg">#FEF3C7</Color>
    <Color x:Key="ColorUnknownFg">#B45309</Color>
    <Color x:Key="ColorUnknownBorder">#FDE68A</Color>

    <!-- Action Colors -->
    <Color x:Key="ColorPrimaryBtn">#1D4ED8</Color>
    <Color x:Key="ColorPrimaryBtnHover">#1E40AF</Color>
    <Color x:Key="ColorStopBtn">#DC2626</Color>
    <Color x:Key="ColorStopBtnHover">#B91C1C</Color>

    <!-- Meter Colors -->
    <Color x:Key="ColorMeterNormal">#16A34A</Color>
    <Color x:Key="ColorMeterAmber">#D97706</Color>
    <Color x:Key="ColorMeterRed">#DC2626</Color>
    <Color x:Key="ColorMeterTrack">#E5E7EB</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource ColorBorderDark}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource ColorTextDisabled}" />

    <SolidColorBrush x:Key="PassBgBrush" Color="{StaticResource ColorPassBg}" />
    <SolidColorBrush x:Key="PassFgBrush" Color="{StaticResource ColorPassFg}" />
    <SolidColorBrush x:Key="PassBorderBrush" Color="{StaticResource ColorPassBorder}" />

    <SolidColorBrush x:Key="FailBgBrush" Color="{StaticResource ColorFailBg}" />
    <SolidColorBrush x:Key="FailFgBrush" Color="{StaticResource ColorFailFg}" />
    <SolidColorBrush x:Key="FailBorderBrush" Color="{StaticResource ColorFailBorder}" />

    <SolidColorBrush x:Key="UnknownBgBrush" Color="{StaticResource ColorUnknownBg}" />
    <SolidColorBrush x:Key="UnknownFgBrush" Color="{StaticResource ColorUnknownFg}" />
    <SolidColorBrush x:Key="UnknownBorderBrush" Color="{StaticResource ColorUnknownBorder}" />

    <SolidColorBrush x:Key="PrimaryBtnBrush" Color="{StaticResource ColorPrimaryBtn}" />
    <SolidColorBrush x:Key="PrimaryBtnHoverBrush" Color="{StaticResource ColorPrimaryBtnHover}" />
    <SolidColorBrush x:Key="StopBtnBrush" Color="{StaticResource ColorStopBtn}" />
    <SolidColorBrush x:Key="StopBtnHoverBrush" Color="{StaticResource ColorStopBtnHover}" />

    <SolidColorBrush x:Key="MeterNormalBrush" Color="{StaticResource ColorMeterNormal}" />
    <SolidColorBrush x:Key="MeterAmberBrush" Color="{StaticResource ColorMeterAmber}" />
    <SolidColorBrush x:Key="MeterRedBrush" Color="{StaticResource ColorMeterRed}" />
    <SolidColorBrush x:Key="MeterTrackBrush" Color="{StaticResource ColorMeterTrack}" />

    <!-- Sharp Corner Radius: 0-2px Maximum -->
    <CornerRadius x:Key="SharpCorner">1</CornerRadius>
    <CornerRadius x:Key="ZeroCorner">0</CornerRadius>

    <!-- Typography: Segoe UI -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>

    <!-- Base TextBlock Style -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Standard Engineering Button Style -->
    <Style x:Key="EngineeringButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SharpCorner}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E5E7EB" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Action Button (Start) -->
    <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource EngineeringButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryBtnBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#1E40AF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SharpCorner}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBtnHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1E3A8A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stop Action Button -->
    <Style x:Key="StopActionButton" TargetType="Button" BasedOn="{StaticResource EngineeringButton}">
        <Setter Property="Background" Value="{StaticResource StopBtnBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#B91C1C" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SharpCorner}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource StopBtnHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#991B1B" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#FEE2E2" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#FECACA" />
                            <Setter Property="Foreground" Value="#F87171" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Technical Card Panel -->
    <Style x:Key="EngineeringCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SharpCorner}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Header Section Label -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Engineering ComboBox Style -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Engineering CheckBox Style -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Engineering Slider Style -->
    <Style TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TickPlacement" Value="None" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
    </Style>

</ResourceDictionary>
