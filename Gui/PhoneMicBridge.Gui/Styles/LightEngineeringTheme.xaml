<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Honest Design Technical Light Theme Palette (SSOT: SPEC-005, OPS-002, CLAIM-001) -->
    <Color x:Key="ColorBackground">#F8F9FA</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorPanel">#F3F4F6</Color>
    <Color x:Key="ColorBorder">#D1D5DB</Color>
    <Color x:Key="ColorBorderSubtle">#E5E7EB</Color>
    <Color x:Key="ColorBorderDark">#9CA3AF</Color>

    <Color x:Key="ColorTextPrimary">#111827</Color>
    <Color x:Key="ColorTextSecondary">#374151</Color>
    <Color x:Key="ColorTextMuted">#6B7280</Color>
    <Color x:Key="ColorTextDisabled">#9CA3AF</Color>

    <!-- Technical Status Colors -->
    <Color x:Key="ColorPassBg">#DCFCE7</Color>
    <Color x:Key="ColorPassFg">#15803D</Color>
    <Color x:Key="ColorPassBorder">#86EFAC</Color>

    <Color x:Key="ColorFailBg">#FEE2E2</Color>
    <Color x:Key="ColorFailFg">#B91C1C</Color>
    <Color x:Key="ColorFailBorder">#FCA5A5</Color>

    <Color x:Key="ColorUnknownBg">#FEF3C7</Color>
    <Color x:Key="ColorUnknownFg">#B45309</Color>
    <Color x:Key="ColorUnknownBorder">#FDE68A</Color>

    <!-- Action Colors -->
    <Color x:Key="ColorPrimaryBtn">#1D4ED8</Color>
    <Color x:Key="ColorPrimaryBtnHover">#1E40AF</Color>
    <Color x:Key="ColorStopBtn">#DC2626</Color>
    <Color x:Key="ColorStopBtnHover">#B91C1C</Color>

    <!-- Meter Colors -->
    <Color x:Key="ColorMeterNormal">#16A34A</Color>
    <Color x:Key="ColorMeterAmber">#D97706</Color>
    <Color x:Key="ColorMeterRed">#DC2626</Color>
    <Color x:Key="ColorMeterTrack">#E5E7EB</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource ColorBorderDark}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource ColorTextDisabled}" />

    <SolidColorBrush x:Key="PassBgBrush" Color="{StaticResource ColorPassBg}" />
    <SolidColorBrush x:Key="PassFgBrush" Color="{StaticResource ColorPassFg}" />
    <SolidColorBrush x:Key="PassBorderBrush" Color="{StaticResource ColorPassBorder}" />

    <SolidColorBrush x:Key="FailBgBrush" Color="{StaticResource ColorFailBg}" />
    <SolidColorBrush x:Key="FailFgBrush" Color="{StaticResource ColorFailFg}" />
    <SolidColorBrush x:Key="FailBorderBrush" Color="{StaticResource ColorFailBorder}" />

    <SolidColorBrush x:Key="UnknownBgBrush" Color="{StaticResource ColorUnknownBg}" />
    <SolidColorBrush x:Key="UnknownFgBrush" Color="{StaticResource ColorUnknownFg}" />
    <SolidColorBrush x:Key="UnknownBorderBrush" Color="{StaticResource ColorUnknownBorder}" />

    <SolidColorBrush x:Key="PrimaryBtnBrush" Color="{StaticResource ColorPrimaryBtn}" />
    <SolidColorBrush x:Key="PrimaryBtnHoverBrush" Color="{StaticResource ColorPrimaryBtnHover}" />
    <SolidColorBrush x:Key="StopBtnBrush" Color="{StaticResource ColorStopBtn}" />
    <SolidColorBrush x:Key="StopBtnHoverBrush" Color="{StaticResource ColorStopBtnHover}" />

    <SolidColorBrush x:Key="MeterNormalBrush" Color="{StaticResource ColorMeterNormal}" />
    <SolidColorBrush x:Key="MeterAmberBrush" Color="{StaticResource ColorMeterAmber}" />
    <SolidColorBrush x:Key="MeterRedBrush" Color="{StaticResource ColorMeterRed}" />
    <SolidColorBrush x:Key="MeterTrackBrush" Color="{StaticResource ColorMeterTrack}" />

    <!-- Sharp Corner Radius: 0-2px Maximum -->
    <CornerRadius x:Key="SharpCorner">1</CornerRadius>
    <CornerRadius x:Key="ZeroCorner">0</CornerRadius>

    <!-- Typography: Segoe UI -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>

    <!-- Base TextBlock Style -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Standard Engineering Button Style -->
    <Style x:Key="EngineeringButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SharpCorner}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E5E7EB" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Action Button (Start) -->
    <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource EngineeringButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryBtnBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#1E40AF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SharpCorner}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBtnHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1E3A8A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stop Action Button -->
    <Style x:Key="StopActionButton" TargetType="Button" BasedOn="{StaticResource EngineeringButton}">
        <Setter Property="Background" Value="{StaticResource StopBtnBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#B91C1C" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SharpCorner}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource StopBtnHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#991B1B" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#FEE2E2" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#FECACA" />
                            <Setter Property="Foreground" Value="#F87171" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Technical Card Panel -->
    <Style x:Key="EngineeringCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SharpCorner}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Header Section Label -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Engineering ComboBox Style -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Engineering CheckBox Style -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Engineering Slider Style -->
    <Style TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TickPlacement" Value="None" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
    </Style>

    <!-- ================================================================= -->
    <!-- NATIVE-LOOKING DESKTOP UI (Menu & ContextMenu Overrides)          -->
    <!-- Intent: Windows-native behavior + modern Windows visual appearance -->
    <!-- ================================================================= -->
    
    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,0" />
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="templateRoot" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4" 
                            Margin="2,1" 
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid x:Name="SubmenuGrid" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,8,0" />
                                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="InputGestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                <Path x:Name="RightArrow" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Data="M 0 0 L 3.5 3.5 L 0 7 Z" Fill="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" Margin="4,0,0,0" />
                            </Grid>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade">
                                <Border x:Name="SubMenuBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="0,2" Margin="0,0,8,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="8" ShadowDepth="2" />
                                    </Border.Effect>
                                    <ScrollViewer Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}" 
                                                  CanContentScroll="True" 
                                                  VerticalScrollBarVisibility="Auto" 
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <Grid RenderOptions.ClearTypeHint="Enabled">
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Top-Level Headers (File, View, Tools) -->
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter TargetName="SubmenuGrid" Property="Margin" Value="6,4" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InputGestureText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightArrow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            <Setter TargetName="HeaderHost" Property="Grid.Column" Value="0" />
                            <Setter TargetName="HeaderHost" Property="Grid.ColumnSpan" Value="4" />
                        </Trigger>
                        
                        <!-- Top-Level Items (Clickable items with no submenus on the main bar) -->
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter TargetName="SubmenuGrid" Property="Margin" Value="6,4" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InputGestureText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightArrow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderHost" Property="Grid.Column" Value="0" />
                            <Setter TargetName="HeaderHost" Property="Grid.ColumnSpan" Value="4" />
                        </Trigger>
                        
                        <!-- Submenu Header (Item with a nested submenu) -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="RightArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                        </Trigger>
                        
                        <!-- Hover State -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="templateRoot" Property="Background" Value="{StaticResource PanelBrush}" />
                        </Trigger>
                        
                        <!-- Pressed / Opened State -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="templateRoot" Property="Background" Value="{StaticResource BorderSubtleBrush}" />
                        </Trigger>
                        
                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter TargetName="InputGestureText" Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="12,0,12,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
