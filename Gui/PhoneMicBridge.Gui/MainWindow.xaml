<Window x:Class="PhoneMicBridge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PhoneMicBridge.Gui.Converters"
        xmlns:gui="clr-namespace:PhoneMicBridge.Gui"
        xmlns:vm="clr-namespace:PhoneMicBridge.Gui.ViewModels"
        mc:Ignorable="d"
        Title="Phone Mic Bridge by Gawasna v0.0.2 - Audio Bridge &amp; Diagnostics Studio"
        Width="720" Height="680"
        MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Value Converters -->
        <conv:StatusToBackgroundConverter x:Key="StatusBgConv" />
        <conv:StatusToForegroundConverter x:Key="StatusFgConv" />
        <conv:StatusToBorderConverter x:Key="StatusBorderConv" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <gui:StatusToRemediationVisibilityConverter x:Key="StatusToRemediationVisConv" />

        <!-- Accent Brushes (Pro Audio Studio Dark Palette) -->
        <SolidColorBrush x:Key="TechGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="TechGreenBgBrush" Color="#064E3B" />
        <SolidColorBrush x:Key="TechGreenBorderBrush" Color="#059669" />
        <SolidColorBrush x:Key="TechAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TechAmberBgBrush" Color="#451A03" />
        <SolidColorBrush x:Key="TechAmberBorderBrush" Color="#D97706" />
        <SolidColorBrush x:Key="TechRedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TechRedBgBrush" Color="#450A0A" />
        <SolidColorBrush x:Key="TechRedBorderBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="TechCyanBrush" Color="#06B6D4" />
        <SolidColorBrush x:Key="TechCyanBgBrush" Color="#083344" />
        <SolidColorBrush x:Key="TechCyanBorderBrush" Color="#0E7490" />
        <SolidColorBrush x:Key="TechPinkBrush" Color="#EC4899" />
        <SolidColorBrush x:Key="TechPinkBgBrush" Color="#500724" />
        <SolidColorBrush x:Key="TechPinkBorderBrush" Color="#DB2777" />
        <SolidColorBrush x:Key="TechMeterTrackBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="ToolbarBgBrush" Color="#0B0F19" />
        <SolidColorBrush x:Key="SubToolbarBgBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="DarkBorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="TerminalBgBrush" Color="#030712" />

        <!-- Engineering Progress Bar Style (VU Meter Gradient) -->
        <Style x:Key="EngineeringProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="{StaticResource TechMeterTrackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Toolbar Button Style -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource SharpCorner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#0B0F19" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SubToolbar Action Buttons (36x36) -->
        <Style x:Key="SquareActionButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource SharpCorner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DSP Toggle Button Style -->
        <Style x:Key="DspToggleButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ================================================================= -->
    <!-- SAFE ZONE: 4-Row Grid Layout Matching Wireframe v0.0.2            -->
    <!-- Row 0: Toolbar (40px)                                             -->
    <!-- Row 1: SubToolbar (48px - Action1 159px + Select Section 504px)   -->
    <!-- Row 2: Body (Flex * - SideSection 268px + MainSection)            -->
    <!-- Row 3: Statusbar (32px - Truthful Status 3-Tier)                  -->
    <!-- ================================================================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" /> <!-- Row 0: Toolbar (40px) -->
            <RowDefinition Height="48" /> <!-- Row 1: SubToolbar (48px) -->
            <RowDefinition Height="*" MinHeight="450" />  <!-- Row 2: Body (528px+ Flex) -->
            <RowDefinition Height="32" /> <!-- Row 3: Statusbar (32px) -->
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: TOOLBAR (40px)                                             -->
        <!-- Top Menu Items & Global Action Shortcuts                          -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBgBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5">
            <DockPanel LastChildFill="False">
                <!-- Left: Native Menu & Global Operations -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Diagnostics -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunDiagnosticsCommand}" Margin="0,0,6,0" ToolTip="Run hardware pre-flight checks">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1 7 H 4 L 7 1 L 10 13 L 13 4 L 15 7 H 18" Stroke="#38BDF8" StrokeThickness="1.5" Width="14" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Diagnostics" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Scan Devices -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshDevicesCommand}" Margin="0,0,6,0" ToolTip="Enumerate active Bluetooth &amp; WASAPI endpoints">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 13.5 4.5 A 6 6 0 1 0 15 9 M 15 4 V 8 H 11" Stroke="#34D399" StrokeThickness="1.4" Width="13" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Scan Devices" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Clear Error -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearErrorCommand}" IsEnabled="{Binding HasError}" Margin="0,0,6,0" ToolTip="Dismiss current error condition">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 4 5 H 12 M 5 5 V 13 H 11 V 5 M 7 3 H 9" Stroke="#F87171" StrokeThickness="1.3" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Clear Error" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Load Audio File -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding BrowseAudioFileCommand}" Margin="0,0,6,0" ToolTip="Select WAV/MP3 file for test playback">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 2 3 H 6 L 8 5 H 14 V 12 H 2 Z" Stroke="#FBBF24" StrokeThickness="1.3" Fill="Transparent" Width="13" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Load Audio" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Engine Specs -->
                    <Button Style="{StaticResource ToolbarButton}" Click="EngineSpecsButton_Click" ToolTip="View engine transport specifications">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 7 2 A 5 5 0 1 0 7 12 A 5 5 0 1 0 7 2 M 7 5 V 8 M 7 10 V 10.5" Stroke="#94A3B8" StrokeThickness="1.4" Width="13" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Specs" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Audio Engine Sampling Rate & Session State Badge -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="16.0 kHz • 16-bit Mono" FontSize="9" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{Binding Snapshot.State, Converter={StaticResource StatusBgConv}}"
                            BorderBrush="{Binding Snapshot.State, Converter={StaticResource StatusBorderConv}}"
                            BorderThickness="1" CornerRadius="2" Padding="8,3">
                        <TextBlock Text="{Binding StateText}" FontWeight="Bold" FontSize="10" 
                                   Foreground="{Binding Snapshot.State, Converter={StaticResource StatusFgConv}}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: SUBTOOLBAR (48px)                                          -->
        <!-- Modeled after Wireframe v0.0.2:                                   -->
        <!-- Left: Action1 (159px: Start/Stop, Mute Mic, Route Switch, Tone)   -->
        <!-- Right: Select Section (504px: Client Section + Devices Section)   -->
        <!-- ================================================================= -->
        <Border Grid.Row="1" Background="{StaticResource SubToolbarBgBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="False">
                <!-- Group 1: Action1 (Left Group, 159px width alignment) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Width="159">
                    <!-- ActBtn 1: Start / Stop Button (36x36) -->
                    <Grid Width="36" Height="36" Margin="0,0,6,0">
                        <!-- START Button (Visible when CanStart) -->
                        <Button Style="{StaticResource SquareActionButton}" 
                                Command="{Binding StartCommand}" 
                                ToolTip="{Binding StartButtonTooltip}"
                                Background="{StaticResource TechGreenBgBrush}"
                                BorderBrush="{StaticResource TechGreenBorderBrush}"
                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVisConv}}">
                            <Path Data="M 5 3 L 15 9 L 5 15 Z" Fill="{StaticResource TechGreenBrush}" Width="14" Height="14" />
                        </Button>

                        <!-- STOP Button (Visible when CanStop) -->
                        <Button Style="{StaticResource SquareActionButton}" 
                                Command="{Binding StopCommand}" 
                                ToolTip="Stop active streaming session"
                                Background="{StaticResource TechRedBgBrush}"
                                BorderBrush="{StaticResource TechRedBorderBrush}"
                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVisConv}}">
                            <Rectangle Fill="{StaticResource TechRedBrush}" Width="12" Height="12" />
                        </Button>
                    </Grid>

                    <!-- ActBtn 2: Mic Mute / Unmute Button (36x36) -->
                    <Button Style="{StaticResource SquareActionButton}" 
                            Command="{Binding ToggleMicCommand}" 
                            Margin="0,0,6,0"
                            ToolTip="{Binding MicMuteButtonText}">
                        <Grid>
                            <!-- UNMUTED Icon (Mic active) -->
                            <Path Data="M 6 1 A 2 2 0 0 0 4 3 V 7 A 2 2 0 0 0 8 7 V 3 A 2 2 0 0 0 6 1 Z M 10 6 V 7 A 4 4 0 0 1 2 7 V 6 H 1 V 7 A 5 5 0 0 0 5.5 11.9 V 14 H 6.5 V 11.9 A 5 5 0 0 0 11 7 V 6 Z" 
                                  Fill="{StaticResource TextPrimaryBrush}" Width="12" Height="14"
                                  Visibility="{Binding IsMicMuted, Converter={StaticResource BoolToVisConv}, ConverterParameter=Inverse}" />

                            <!-- MUTED Icon (Mic muted) -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMicMuted, Converter={StaticResource BoolToVisConv}}">
                                <Path Data="M 1 1 L 11 11 M 6 1 A 2 2 0 0 0 4 3 V 7 M 10 6 V 7 A 4 4 0 0 1 2 7" 
                                      Stroke="{StaticResource TechRedBrush}" StrokeThickness="1.5" Width="12" Height="12" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- ActBtn 3: Route Mode Segmented Switch (IN / OUT - 39x36) -->
                    <Border Background="#1E293B" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="1" Height="36" Width="39" Margin="0,0,6,0" Padding="1" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleRouteModeCommand}" ToolTip="Toggle Route Direction (IN: Capture PC Mic -> Phone | OUT: PC Speaker -> Phone)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RouteModeText}" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                <Path Data="M 1 4 L 5 1 L 5 7 Z M 9 4 L 5 7" Stroke="#38BDF8" StrokeThickness="1" Width="10" Height="8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- ActBtn 4: Test Tone Generator Button (36x36) -->
                    <Button Style="{StaticResource SquareActionButton}" 
                            Command="{Binding ToggleTestToneCommand}" 
                            ToolTip="{Binding ToneStatusText}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,0,1">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#475569" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToneEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource TechAmberBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="1kHz" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Group 2: Select Section (Right Group, 504px width alignment from Wireframe v0.0.2) -->
                <!-- Contains Client Section (Cyan subtle border) and Devices Section (Pink subtle border) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- ========================================================= -->
                    <!-- CLIENT SECTION (Source: Bluetooth Client Phone/Headset)   -->
                    <!-- Cyan Accent from Wireframe v0.0.2 (#B9FFFD)               -->
                    <!-- ========================================================= -->
                    <Border Background="{StaticResource TechCyanBgBrush}" BorderBrush="{StaticResource TechCyanBorderBrush}" BorderThickness="1" CornerRadius="2" Width="244" Height="38" Padding="4,1" Margin="0,0,8,0">
                        <DockPanel LastChildFill="True">
                            <!-- Category Glyph Icon (Matching Figma node 30:406) -->
                            <Border Width="22" Height="22" Background="#0C4A6E" CornerRadius="2" Margin="0,0,4,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Path Data="M 6 2 H 18 A 2 2 0 0 1 20 4 V 20 A 2 2 0 0 1 18 22 H 6 A 2 2 0 0 1 4 20 V 4 A 2 2 0 0 1 6 2 Z M 12 18 A 1 1 0 1 0 12 20 A 1 1 0 1 0 12 18 Z" 
                                      Stroke="{StaticResource TechCyanBrush}" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" Width="10" Height="12" />
                            </Border>

                            <!-- Settings shortcut button -->
                            <Button DockPanel.Dock="Right" Command="{Binding OpenBluetoothSettingsCommand}" Style="{StaticResource ToolbarButton}" Width="22" Height="24" Padding="0" Margin="2,0,0,0" ToolTip="Open Windows Bluetooth Settings (ms-settings:bluetooth)">
                                <Path Data="M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 1 0 12 15 M 19.4 15 A 1.65 1.65 0 0 0 19.73 16.82 L 19.8 16.9 A 2 2 0 1 1 17 19.7 L 16.9 19.6 A 1.65 1.65 0 0 0 15 19.4 A 1.65 1.65 0 0 0 13.5 20.9 L 13.5 21 A 2 2 0 1 1 9.5 21 L 9.5 20.9 A 1.65 1.65 0 0 0 8 19.4 A 1.65 1.65 0 0 0 6.18 19.73 L 6.1 19.8 A 2 2 0 1 1 3.3 17 L 3.4 16.9 A 1.65 1.65 0 0 0 3.6 15 A 1.65 1.65 0 0 0 2.1 13.5 L 2 13.5 A 2 2 0 1 1 2 9.5 L 2.1 9.5 A 1.65 1.65 0 0 0 3.6 8 A 1.65 1.65 0 0 0 3.27 6.18 L 3.2 6.1 A 2 2 0 1 1 6 3.3 L 6.1 3.4 A 1.65 1.65 0 0 0 8 3.6 A 1.65 1.65 0 0 0 9.5 2.1 L 9.5 2 A 2 2 0 1 1 13.5 2 L 13.5 2.1 A 1.65 1.65 0 0 0 15 3.6 A 1.65 1.65 0 0 0 16.82 3.27 L 16.9 3.2 A 2 2 0 1 1 19.7 6 L 19.6 6.1 A 1.65 1.65 0 0 0 19.4 8 A 1.65 1.65 0 0 0 20.9 9.5 L 21 9.5 A 2 2 0 1 1 21 13.5 L 20.9 13.5 A 1.65 1.65 0 0 0 19.4 15 Z" 
                                      Stroke="#94A3B8" StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform" />
                            </Button>

                            <!-- WinRT Radio Power Button (from commit 1b99a7b9) -->
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleBluetoothRadioCommand}" Height="24" Padding="5,0" Margin="2,0,0,0" ToolTip="{Binding BluetoothButtonToolTip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                        <Setter Property="Background" Value="#1E293B" />
                                        <Setter Property="BorderBrush" Value="#334155" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBluetoothEnabled}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TechGreenBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource TechGreenBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOperatingBluetoothRadio}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding BluetoothRadioText}" FontSize="8" FontWeight="Bold" Foreground="{Binding IsBluetoothEnabled, Converter={StaticResource StatusFgConv}}" VerticalAlignment="Center" />
                            </Button>

                            <!-- Bluetooth Device ComboBox -->
                            <ComboBox ItemsSource="{Binding BluetoothDevices}" 
                                      SelectedItem="{Binding SelectedBluetoothDevice, Mode=TwoWay}"
                                      Height="26" VerticalContentAlignment="Center" Background="#0F172A" BorderBrush="{StaticResource DarkBorderBrush}" ToolTip="Select paired Bluetooth client (Phone/Headset)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <!-- Support Status Badge (Matching node 28:34) -->
                                            <Border CornerRadius="1" Padding="3,1" Margin="4,0,0,0" DockPanel.Dock="Right" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                                <TextBlock Text="{Binding BridgeSupportStatus}" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" />
                                            </Border>
                                            <!-- Category Glyph Text -->
                                            <Border CornerRadius="1" Padding="2,0" Margin="0,0,4,0" DockPanel.Dock="Left" Background="#083344">
                                                <TextBlock Text="{Binding CategoryText}" FontSize="7" FontWeight="Bold" Foreground="{StaticResource TechCyanBrush}" />
                                            </Border>
                                            <!-- Device Name in Bold (Matching node 28:34) -->
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- DEVICES SECTION (Target: Host PC Endpoint)                -->
                    <!-- Pink Accent from Wireframe v0.0.2 (#FFC8C8)               -->
                    <!-- ========================================================= -->
                    <Border Background="{StaticResource TechPinkBgBrush}" BorderBrush="{StaticResource TechPinkBorderBrush}" BorderThickness="1" CornerRadius="2" Width="244" Height="38" Padding="4,1">
                        <DockPanel LastChildFill="True">
                            <!-- Directional Label Badge -->
                            <Border CornerRadius="1" Padding="4,2" Margin="0,0,4,0" DockPanel.Dock="Left" Background="#831843" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Dropdown2Label}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TechPinkBrush}" />
                            </Border>

                            <!-- Host Endpoint ComboBox -->
                            <ComboBox ItemsSource="{Binding AvailableEndpointDevices}" 
                                      SelectedItem="{Binding SelectedEndpointDevice, Mode=TwoWay}"
                                      Height="26" VerticalContentAlignment="Center" Background="#0F172A" BorderBrush="{StaticResource DarkBorderBrush}" ToolTip="Select host audio endpoint for bridge route">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="1" Padding="3,1" Margin="4,0,0,0" DockPanel.Dock="Right" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisConv}}">
                                                <TextBlock Text="DEF" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TechPinkBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 2: BODY (Flex *, MinHeight 450px)                             -->
        <!-- Left: SideSection (268px: Presets Section + System Resources)     -->
        <!-- Right: MainSection (Flex *: VU Meter + Playground + Console)      -->
        <!-- ================================================================= -->
        <Grid Grid.Row="2" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" /> <!-- SideSection -->
                <ColumnDefinition Width="*" />   <!-- MainSection -->
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- LEFT COLUMN: SideSection (268px)                              -->
            <!-- Modeled after Wireframe v0.0.2 SideSection                    -->
            <!-- ============================================================= -->
            <Border Grid.Column="0" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <StackPanel>
                        <!-- ===================================================== -->
                        <!-- CARD 1: PRESETS SECTION (Figma v0.0.2 Presets)        -->
                        <!-- ===================================================== -->
                        <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="PRESETS &amp; PROFILES" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" Margin="0" />
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" Padding="4,1" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding SelectedPreset.Tag, FallbackValue='VOICE'}" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" />
                                    </Border>
                                </DockPanel>

                                <!-- Preset Profile Selector Buttons -->
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Background="{StaticResource PanelBrush}" Margin="0,0,0,4" Padding="6,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="8" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="LOAD" 
                                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DspToggleButton}" Height="20" Padding="6,1" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ===================================================== -->
                        <!-- CARD 2: PRE-FLIGHT HARDWARE DIAGNOSTICS               -->
                        <!-- ===================================================== -->
                        <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <TextBlock Text="PRE-FLIGHT DIAGNOSTICS" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" Margin="0" />
                                    <Border Background="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusBgConv}}" 
                                            BorderBrush="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusBorderConv}}" 
                                            BorderThickness="1" CornerRadius="1" Padding="6,1" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding PreflightBadgeText}" FontSize="8" FontWeight="Bold" 
                                                   Foreground="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusFgConv}}" />
                                    </Border>
                                </DockPanel>

                                <!-- Items List -->
                                <ItemsControl ItemsSource="{Binding Snapshot.PreflightItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}" 
                                                    Background="{Binding Status, Converter={StaticResource StatusBgConv}}" 
                                                    BorderThickness="1" CornerRadius="1" Padding="6" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="10" 
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" 
                                                                   DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                        <Border Background="{StaticResource SurfaceBrush}"
                                                                BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}"
                                                                BorderThickness="1" CornerRadius="1" Padding="4,1" DockPanel.Dock="Right">
                                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="8" 
                                                                       Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" />
                                                        </Border>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding Details}" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" 
                                                               Margin="0,2,0,0" TextWrapping="Wrap" />

                                                    <!-- Remediation Guidance Callout -->
                                                    <Border Background="{StaticResource SurfaceBrush}" 
                                                            BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}" 
                                                            BorderThickness="1" CornerRadius="1" Padding="5,3" Margin="0,3,0,0"
                                                            Visibility="{Binding Status, Converter={StaticResource StatusToRemediationVisConv}}">
                                                        <StackPanel>
                                                            <TextBlock Text="REMEDIATION:" FontWeight="Bold" FontSize="8" Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" />
                                                            <TextBlock Text="{Binding RemediationText}" FontSize="8" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ===================================================== -->
                        <!-- CARD 3: SYSTEM RESOURCES MONITOR                      -->
                        <!-- (Figma v0.0.2 System Resources Monitor)               -->
                        <!-- ===================================================== -->
                        <Border Style="{StaticResource EngineeringCard}" Padding="10">
                            <StackPanel>
                                <TextBlock Text="SYSTEM RESOURCES &amp; TELEMETRY" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                
                                <!-- Safety Interlock -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6,3" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding SafetyInterlockStatusText}" FontSize="8" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Target Audio Buffer:" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Text="~12 - 20 ms Target" FontSize="8" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{StaticResource TechGreenBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Buffer Overflows:" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Text="0 Underruns" FontSize="8" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Audio Thread Latency:" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Text="Optimal (&lt; 5ms Jitter)" FontSize="8" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{StaticResource TechGreenBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================================= -->
            <!-- RIGHT COLUMN: MainSection (Flexible width, min 444px)         -->
            <!-- Modeled after Wireframe v0.0.2 MainSection:                   -->
            <!-- 1. VU Meter Section                                           -->
            <!-- 2. Configure / Customize / Playground Section                 -->
            <!-- 3. Logging Console Section                                    -->
            <!-- ============================================================= -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                    <StackPanel>
                        <!-- Error Alert Banner (Visible when HasError) -->
                        <Border Background="{StaticResource TechRedBgBrush}" BorderBrush="{StaticResource TechRedBorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8" Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVisConv}}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="DISMISS" Command="{Binding ClearErrorCommand}" Style="{StaticResource ToolbarButton}" Height="22" Padding="6,1" FontSize="9" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ENGINE FAILURE DETECTED" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TechRedBrush}" />
                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="9" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ===================================================== -->
                        <!-- BLOCK 1: REAL-TIME VU METERS (Figma v0.0.2 VU meter)  -->
                        <!-- ===================================================== -->
                        <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="REAL-TIME AUDIO MONITOR (30Hz Polling)" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" Margin="0" />
                                    <TextBlock Text="PEAK / RMS LEVEL METERS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Input Peak Meter -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,2">
                                        <TextBlock Text="INPUT (Capture Mic / Bluetooth)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <!-- Clip LED -->
                                            <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1E293B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInputClipping}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource TechRedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding InputPeakDbText}" FontSize="9" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{Binding InputMeterBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Grid.Row="1" Style="{StaticResource EngineeringProgressBar}" 
                                                 Value="{Binding InputPeakPercent, Mode=OneWay}" 
                                                 Foreground="{Binding InputMeterBrush}" />
                                </Grid>

                                <!-- Output Peak Meter -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,2">
                                        <TextBlock Text="OUTPUT (Render Endpoint / Host)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <!-- Clip LED -->
                                            <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1E293B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutputClipping}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource TechRedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding OutputPeakDbText}" FontSize="9" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{Binding OutputMeterBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Grid.Row="1" Style="{StaticResource EngineeringProgressBar}" 
                                                 Value="{Binding OutputPeakPercent, Mode=OneWay}" 
                                                 Foreground="{Binding OutputMeterBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===================================================== -->
                        <!-- BLOCK 2: CONFIGURE / PLAYGROUND SECTION               -->
                        <!-- (Figma v0.0.2 Configure / Playground Section)         -->
                        <!-- ===================================================== -->
                        <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="AUDIO PIPELINE &amp; SOURCE FADERS" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" Margin="0" />
                                    <TextBlock Text="GAIN STAGING &amp; DSP" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Channel 1: Microphone Source -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="MIC CHANNEL" FontWeight="Bold" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding MicStatusText}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="4.0" Value="{Binding MicGain, Mode=TwoWay}" 
                                                VerticalAlignment="Center" Margin="6,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding MicGainText}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="10" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#38BDF8" />
                                    </Grid>
                                </Border>

                                <!-- Channel 2: 1000 Hz Sine Wave Test Tone -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="TEST TONE (1kHz)" FontWeight="Bold" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="-12 dBFS Ref" FontSize="7" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding ToneGain, Mode=TwoWay}" 
                                                VerticalAlignment="Center" Margin="6,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ToneGainText}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="10" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TechAmberBrush}" />
                                    </Grid>
                                </Border>

                                <!-- Channel 3: Audio File Playback -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="FILE PLAYBACK" FontWeight="Bold" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding AudioFileStatusText}" FontSize="7" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding FileGain, Mode=TwoWay}" 
                                                VerticalAlignment="Center" Margin="6,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding FileGainText}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="10" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A78BFA" />
                                    </Grid>
                                </Border>

                                <!-- DSP Quick Conditioning Strip -->
                                <Border Background="#111827" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6,4">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="DSP FILTERS:" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        
                                        <!-- High-Pass Filter Toggle -->
                                        <Button DockPanel.Dock="Left" Command="{Binding ToggleHighPassFilterCommand}" Style="{StaticResource DspToggleButton}" Margin="0,0,4,0" ToolTip="Toggle 80Hz High-Pass Filter to cut desk rumble">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="HPF (80Hz): " FontSize="8" />
                                                <TextBlock Text="{Binding IsHighPassFilterEnabled, Converter={StaticResource StatusFgConv}}" FontWeight="Bold" FontSize="8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="ACTIVE" />
                                                            <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighPassFilterEnabled}" Value="False">
                                                                    <Setter Property="Text" Value="BYPASS" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Noise Gate Toggle -->
                                        <Button DockPanel.Dock="Left" Command="{Binding ToggleNoiseGateCommand}" Style="{StaticResource DspToggleButton}" Margin="0,0,4,0" ToolTip="Toggle Noise Gate (-45 dBFS Threshold)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="GATE (-45dB): " FontSize="8" />
                                                <TextBlock Text="{Binding IsNoiseGateEnabled, Converter={StaticResource StatusFgConv}}" FontWeight="Bold" FontSize="8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="ACTIVE" />
                                                            <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNoiseGateEnabled}" Value="False">
                                                                    <Setter Property="Text" Value="BYPASS" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Peak Limiter Toggle -->
                                        <Button DockPanel.Dock="Left" Command="{Binding ToggleLimiterCommand}" Style="{StaticResource DspToggleButton}" ToolTip="Toggle Soft Peak Limiter (-0.5 dBFS)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="LIMITER: " FontSize="8" />
                                                <TextBlock Text="{Binding IsLimiterEnabled, Converter={StaticResource StatusFgConv}}" FontWeight="Bold" FontSize="8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="ACTIVE" />
                                                            <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLimiterEnabled}" Value="False">
                                                                    <Setter Property="Text" Value="BYPASS" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ===================================================== -->
                        <!-- BLOCK 3: LIVE DIAGNOSTIC LOGGING CONSOLE              -->
                        <!-- (Figma v0.0.2 Logging console section)                -->
                        <!-- ===================================================== -->
                        <Border Style="{StaticResource EngineeringCard}" Padding="8">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource TechGreenBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="DIAGNOSTIC EVENT LOG" Style="{StaticResource SectionHeader}" Margin="0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="CLEAR" Command="{Binding ClearLogsCommand}" 
                                            Style="{StaticResource DspToggleButton}" Height="18" Padding="6,0" FontSize="8" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Console Terminal Box -->
                                <Border Background="{StaticResource TerminalBgBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="1" Height="85" Padding="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding ConsoleLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 3: STATUSBAR (32px)                                           -->
        <!-- Truthful Status 3-Tier Architecture from Wireframe v0.0.2:        -->
        <!-- 1. Bluetooth: ON/OFF                                              -->
        <!-- 2. Connect Status:                                                -->
        <!-- 3. Link: ●                                                        -->
        <!-- ================================================================= -->
        <Border Grid.Row="3" Background="{StaticResource SubToolbarBgBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /> <!-- Tier 1: Bluetooth Radio Status -->
                    <ColumnDefinition Width="*" /> <!-- Tier 2: Connect Protocol Status -->
                    <ColumnDefinition Width="*" /> <!-- Tier 3: Link Audio Delivery Status -->
                </Grid.ColumnDefinitions>

                <!-- Tier 1: Bluetooth: ON/OFF (Matching Wireframe node 30:340) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TechGreenBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBluetoothDisabled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource TechRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Bluetooth: " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="ON" />
                                <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBluetoothDisabled}" Value="True">
                                        <Setter Property="Text" Value="OFF" />
                                        <Setter Property="Foreground" Value="{StaticResource TechRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Tier 2: Connect Status: (Matching Wireframe node 30:341) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#475569" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Snapshot.State}" Value="Streaming">
                                        <Setter Property="Fill" Value="{StaticResource TechGreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Snapshot.State}" Value="Connecting">
                                        <Setter Property="Fill" Value="{StaticResource TechAmberBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Snapshot.State}" Value="Error">
                                        <Setter Property="Fill" Value="{StaticResource TechRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Connect Status: " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BluetoothStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tier 3: Link: ● (Matching Wireframe node 30:342) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Link: " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="●" FontSize="11" Margin="2,0,4,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Snapshot.State}" Value="Streaming">
                                        <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Snapshot.State}" Value="Connecting">
                                        <Setter Property="Foreground" Value="{StaticResource TechAmberBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Snapshot.State}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource TechRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DeliveryStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
