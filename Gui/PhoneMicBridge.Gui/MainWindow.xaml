<Window x:Class="PhoneMicBridge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PhoneMicBridge.Gui.Converters"
        xmlns:gui="clr-namespace:PhoneMicBridge.Gui"
        xmlns:vm="clr-namespace:PhoneMicBridge.Gui.ViewModels"
        mc:Ignorable="d"
        Title="Phone Mic Bridge - Technical Audio Controller"
        Height="720" Width="820"
        MinHeight="520" MinWidth="380"
        Background="{StaticResource BackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SizeChanged="OnWindowSizeChanged">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:StatusToBackgroundConverter x:Key="StatusBgConv" />
        <conv:StatusToForegroundConverter x:Key="StatusFgConv" />
        <conv:StatusToBorderConverter x:Key="StatusBorderConv" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <gui:StatusToRemediationVisibilityConverter x:Key="StatusToRemediationVisConv" />

        <SolidColorBrush x:Key="TechGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="TechAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TechClipBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TechMeterTrackBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="ClipBgBrush" Color="#FEE2E2" />
        <SolidColorBrush x:Key="ClipBorderBrush" Color="#FCA5A5" />

        <Style x:Key="EngineeringProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="{StaticResource TechMeterTrackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Main Content -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="PHONE MIC BRIDGE" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Desktop Audio Endpoint Bridge for Mobile HFP" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <!-- Header Actions & State Badge -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Session State Badge -->
                    <Border Background="{Binding Snapshot.State, Converter={StaticResource StatusBgConv}}" 
                            BorderBrush="{Binding Snapshot.State, Converter={StaticResource StatusBorderConv}}" 
                            BorderThickness="1" 
                            CornerRadius="{StaticResource SharpCorner}" 
                            Padding="8,3" 
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding StateText}" 
                                   Foreground="{Binding Snapshot.State, Converter={StaticResource StatusFgConv}}" 
                                   FontWeight="Bold" FontSize="11" />
                    </Border>

                    <Button Content="Re-run Diagnostics" 
                            Command="{Binding RunDiagnosticsCommand}" 
                            Style="{StaticResource EngineeringButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN RESPONSIVE CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="AdaptiveGrid" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- LEFT PANEL: Pre-flight Diagnostics & Device Selection -->
                <StackPanel x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" Margin="4">

                    <!-- PRE-FLIGHT DIAGNOSTICS CARD (R2) -->
                    <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock Text="PRE-FLIGHT DIAGNOSTICS" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" />
                                <Border Background="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusBgConv}}" 
                                        BorderBrush="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusBorderConv}}" 
                                        BorderThickness="1" 
                                        CornerRadius="{StaticResource SharpCorner}" 
                                        Padding="6,2" 
                                        DockPanel.Dock="Right">
                                    <TextBlock Text="{Binding PreflightBadgeText}" 
                                               Foreground="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusFgConv}}" 
                                               FontWeight="Bold" FontSize="10" />
                                </Border>
                            </DockPanel>

                            <!-- Diagnostics Items List -->
                            <ItemsControl ItemsSource="{Binding Snapshot.PreflightItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}" 
                                                Background="{Binding Status, Converter={StaticResource StatusBgConv}}" 
                                                BorderThickness="1" 
                                                CornerRadius="{StaticResource SharpCorner}" 
                                                Padding="8" 
                                                Margin="0,0,0,6">
                                            <StackPanel>
                                                <!-- Title and Tri-State Badge Label -->
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                    <Border Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource SharpCorner}"
                                                            Padding="6,2"
                                                            DockPanel.Dock="Right">
                                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="10" Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" />
                                                    </Border>
                                                </DockPanel>

                                                <!-- Verification Details -->
                                                <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                                <!-- Remediation Guidance Callout (Visible on Fail or Unknown) -->
                                                <Border Background="{StaticResource SurfaceBrush}" 
                                                        BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="{StaticResource SharpCorner}" 
                                                        Padding="6,4" 
                                                        Margin="0,5,0,0"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusToRemediationVisConv}}">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="REMEDIATION GUIDANCE:" FontWeight="Bold" FontSize="9" Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" />
                                                        <TextBlock Text="{Binding RemediationText}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- DEVICE SELECTION CARD (R2) -->
                    <Border Style="{StaticResource EngineeringCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock Text="AUDIO DEVICE SELECTION" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" />
                                <Button Content="Scan Devices" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource EngineeringButton}" Padding="6,2" FontSize="10" DockPanel.Dock="Right" />
                            </DockPanel>

                            <!-- Capture Device Selection -->
                            <TextBlock Text="Input Microphone (Capture):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,3" />
                            <ComboBox ItemsSource="{Binding CaptureDevices}" 
                                      SelectedItem="{Binding SelectedCaptureDevice, Mode=TwoWay}"
                                      Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="0,2">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SharpCorner}" Padding="4,1" Margin="6,0,0,0" DockPanel.Dock="Right" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisConv}}">
                                                    <TextBlock Text="DEFAULT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Render Device Selection -->
                            <TextBlock Text="Target Bluetooth Render (Hands-Free):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,3" />
                            <ComboBox ItemsSource="{Binding RenderDevices}" 
                                      SelectedItem="{Binding SelectedRenderDevice, Mode=TwoWay}" 
                                      Margin="0,0,0,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="0,2">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                                <Border Background="{StaticResource PassBgBrush}" BorderBrush="{StaticResource PassBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SharpCorner}" Padding="4,1" Margin="6,0,0,0" DockPanel.Dock="Right" Visibility="{Binding IsTargetHfp, Converter={StaticResource BoolToVisConv}}">
                                                    <TextBlock Text="HFP" FontSize="8" FontWeight="Bold" Foreground="{StaticResource PassFgBrush}" />
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="* Note: System selects devices by stable MMDevice ID to persist configuration across sessions." FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT PANEL: Session Controls, Truthful Status, Source Controls, VU Meter -->
                <StackPanel x:Name="RightPanel" Grid.Column="1" Grid.Row="0" Margin="4">

                    <!-- SESSION CONTROLS & ERROR PANEL (R3) -->
                    <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="SESSION CONTROLS" Style="{StaticResource SectionHeader}" />

                            <!-- Start / Stop Button Row with Safety Interlock Tooltip -->
                            <Grid Margin="0,4,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" 
                                        Content="START BRIDGE" 
                                        Command="{Binding StartCommand}" 
                                        ToolTip="{Binding StartButtonTooltip}"
                                        Style="{StaticResource PrimaryActionButton}" 
                                        Margin="0,0,4,0" 
                                        Height="32" />
                                <Button Grid.Column="1" 
                                        Content="STOP BRIDGE" 
                                        Command="{Binding StopCommand}" 
                                        Style="{StaticResource StopActionButton}" 
                                        Margin="4,0,0,0" 
                                        Height="32" />
                            </Grid>

                            <!-- Error Box if HasError -->
                            <Border Background="{StaticResource FailBgBrush}" 
                                    BorderBrush="{StaticResource FailBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="{StaticResource SharpCorner}" 
                                    Padding="8" 
                                    Margin="0,4,0,0" 
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConv}}">
                                <DockPanel LastChildFill="True">
                                    <Button Content="Clear" 
                                            Command="{Binding ClearErrorCommand}" 
                                            Style="{StaticResource EngineeringButton}" 
                                            Padding="4,2" 
                                            FontSize="9" 
                                            DockPanel.Dock="Right" 
                                            Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding ErrorMessage}" 
                                               Foreground="{StaticResource FailFgBrush}" 
                                               FontSize="10" 
                                               TextWrapping="Wrap" 
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- TRUTHFUL STATUS PANEL (R3) -->
                    <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="TRUTHFUL STATUS TELEMETRY" Style="{StaticResource SectionHeader}" />

                            <!-- Tier 1: Endpoint Render -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1. Endpoint Render:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding EndpointStatusText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>

                            <!-- Tier 2: HFP / SCO Channel -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2. HFP / SCO Channel:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding BluetoothStatusText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>

                            <!-- Tier 3: Audio Delivered to Phone -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="3. Audio Delivered:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DeliveryStatusText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Text="Honest Design note: Tier 3 is unverified until bidirectional mobile companion ACK telemetry is confirmed." 
                                       FontSize="9" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontStyle="Italic" 
                                       Margin="0,4,0,0" 
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- SOURCE CONTROLS CARD (R4) -->
                    <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="AUDIO SOURCE CONTROLS" Style="{StaticResource SectionHeader}" />

                            <!-- 1. Microphone Source Control -->
                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource SharpCorner}" Background="{StaticResource SurfaceBrush}" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="MICROPHONE INPUT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SharpCorner}" Padding="4,1" Margin="6,0,0,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MicStatusText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <Button Content="{Binding MicMuteButtonText}" 
                                                Command="{Binding ToggleMicCommand}" 
                                                Style="{StaticResource EngineeringButton}" 
                                                Padding="6,2" FontSize="10" 
                                                DockPanel.Dock="Right" />
                                    </DockPanel>

                                    <!-- Mic Gain Slider & Value Display -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mic Gain:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding MicGain, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding MicGainText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Test Tone Generator Control -->
                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource SharpCorner}" Background="{StaticResource SurfaceBrush}" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="TEST TONE GENERATOR" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SharpCorner}" Padding="4,1" Margin="6,0,0,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ToneStatusText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <Button Content="{Binding ToneButtonText}" 
                                                Command="{Binding ToggleTestToneCommand}" 
                                                Style="{StaticResource EngineeringButton}" 
                                                Padding="6,2" FontSize="10" 
                                                DockPanel.Dock="Right" />
                                    </DockPanel>

                                    <!-- Tone Gain Slider & Value Display -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tone Gain:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding ToneGain, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ToneGainText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Audio File Player Source -->
                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource SharpCorner}" Background="{StaticResource SurfaceBrush}" Padding="8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="TEST AUDIO FILE PLAYER" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="Browse..." 
                                                    Command="{Binding BrowseAudioFileCommand}" 
                                                    Style="{StaticResource EngineeringButton}" 
                                                    Padding="6,2" FontSize="10" Margin="0,0,4,0" />
                                            <Button Content="{Binding PlayButtonText}" 
                                                    Command="{Binding ToggleFilePlaybackCommand}" 
                                                    Style="{StaticResource EngineeringButton}" 
                                                    Padding="6,2" FontSize="10" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Loaded File Status Text -->
                                    <TextBlock Text="{Binding AudioFileStatusText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />

                                    <!-- File Gain Slider & Value Display -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File Gain:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding FileGain, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding FileGainText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- AUDIO LEVEL METERS (R4) -->
                    <Border Style="{StaticResource EngineeringCard}">
                        <StackPanel>
                            <TextBlock Text="AUDIO LEVEL METERS (ZERO ALLOCATION)" Style="{StaticResource SectionHeader}" />

                            <!-- Mic Input Meter -->
                            <DockPanel LastChildFill="False" Margin="0,2,0,3">
                                <TextBlock Text="MIC INPUT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <Border Background="{StaticResource ClipBgBrush}" 
                                        BorderBrush="{StaticResource ClipBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="{StaticResource SharpCorner}" 
                                        Padding="4,1" 
                                        DockPanel.Dock="Right" 
                                        Margin="6,0,0,0" 
                                        Visibility="{Binding IsInputClipping, Converter={StaticResource BoolToVisConv}}">
                                    <TextBlock Text="CLIP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TechClipBrush}" />
                                </Border>
                                <TextBlock Text="{Binding InputPeakDbText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <ProgressBar Minimum="0" Maximum="100" 
                                         Value="{Binding InputPeakPercent, Mode=OneWay}" 
                                         Foreground="{Binding InputMeterBrush}" 
                                         Style="{StaticResource EngineeringProgressBar}" 
                                         Margin="0,0,0,8" />

                            <!-- Master Output Meter -->
                            <DockPanel LastChildFill="False" Margin="0,2,0,3">
                                <TextBlock Text="MASTER OUTPUT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <Border Background="{StaticResource ClipBgBrush}" 
                                        BorderBrush="{StaticResource ClipBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="{StaticResource SharpCorner}" 
                                        Padding="4,1" 
                                        DockPanel.Dock="Right" 
                                        Margin="6,0,0,0" 
                                        Visibility="{Binding IsOutputClipping, Converter={StaticResource BoolToVisConv}}">
                                    <TextBlock Text="CLIP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TechClipBrush}" />
                                </Border>
                                <TextBlock Text="{Binding OutputPeakDbText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <ProgressBar Minimum="0" Maximum="100" 
                                         Value="{Binding OutputPeakPercent, Mode=OneWay}" 
                                         Foreground="{Binding OutputMeterBrush}" 
                                         Style="{StaticResource EngineeringProgressBar}" 
                                         Margin="0,0,0,4" />

                            <!-- Scale Markers -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-60" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="-30" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="-18" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="3" Text="-6" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="4" Text="0 dBFS" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel LastChildFill="True">
                <TextBlock Text="WASAPI Shared Mode (50ms) | Zero-Alloc Span Metering | net9.0-windows" 
                           FontSize="10" 
                           Foreground="{StaticResource TextMutedBrush}" 
                           DockPanel.Dock="Right" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{Binding SafetyInterlockStatusText}" 
                               FontWeight="Bold"
                               FontSize="10" 
                               Foreground="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusFgConv}}" 
                               Margin="0,0,10,0" />
                    <TextBlock Text="|" 
                               FontSize="10" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Snapshot.StateDescription}" 
                               FontSize="10" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
