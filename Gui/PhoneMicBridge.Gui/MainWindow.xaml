<Window x:Class="PhoneMicBridge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PhoneMicBridge.Gui.Converters"
        xmlns:gui="clr-namespace:PhoneMicBridge.Gui"
        xmlns:vm="clr-namespace:PhoneMicBridge.Gui.ViewModels"
        mc:Ignorable="d"
        Title="Phone Mic Bridge by Gawasna v0.0.1"
        Width="720" Height="680"
        MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Value Converters -->
        <conv:StatusToBackgroundConverter x:Key="StatusBgConv" />
        <conv:StatusToForegroundConverter x:Key="StatusFgConv" />
        <conv:StatusToBorderConverter x:Key="StatusBorderConv" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <gui:StatusToRemediationVisibilityConverter x:Key="StatusToRemediationVisConv" />

        <!-- Accent Brushes -->
        <SolidColorBrush x:Key="TechGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="TechGreenBgBrush" Color="#DCFCE7" />
        <SolidColorBrush x:Key="TechGreenBorderBrush" Color="#86EFAC" />
        <SolidColorBrush x:Key="TechAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TechAmberBgBrush" Color="#FEF3C7" />
        <SolidColorBrush x:Key="TechAmberBorderBrush" Color="#FDE68A" />
        <SolidColorBrush x:Key="TechRedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TechRedBgBrush" Color="#FEE2E2" />
        <SolidColorBrush x:Key="TechRedBorderBrush" Color="#FCA5A5" />
        <SolidColorBrush x:Key="TechMeterTrackBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="ToolbarBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SubToolbarBgBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="DarkBorderBrush" Color="#CBD5E1" />

        <!-- Engineering Progress Bar Style -->
        <Style x:Key="EngineeringProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="{StaticResource TechMeterTrackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Toolbar Button Style -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource SharpCorner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SubToolbar Action Buttons (36x36) -->
        <Style x:Key="SquareActionButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource SharpCorner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- SAFE ZONE: 4-Row Grid Layout (Toolbar 40px, SubToolbar 48px, Body Flex *, Statusbar 32px) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" /> <!-- Row 0: Toolbar (40px) -->
            <RowDefinition Height="48" /> <!-- Row 1: SubToolbar (48px) -->
            <RowDefinition Height="*" MinHeight="450" />  <!-- Row 2: Body (528px+ Flex) -->
            <RowDefinition Height="32" /> <!-- Row 3: Statusbar (32px) -->
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: TOOLBAR (40px)                                             -->
        <!-- 5 Global Action Slots: Diagnostics, Scan, Clear, File, Specs     -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBgBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Slot 1: Diagnostics -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunDiagnosticsCommand}" Margin="0,0,8,0" ToolTip="Run hardware pre-flight checks">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1 7 H 4 L 7 1 L 10 13 L 13 4 L 15 7 H 18" Stroke="#2563EB" StrokeThickness="1.5" Width="14" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Diagnostics" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Slot 2: Scan Devices -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshDevicesCommand}" Margin="0,0,8,0" ToolTip="Enumerate active WASAPI endpoints">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 13.5 4.5 A 6 6 0 1 0 15 9 M 15 4 V 8 H 11" Stroke="#16A34A" StrokeThickness="1.4" Width="13" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Scan Devices" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Slot 3: Clear Error -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearErrorCommand}" IsEnabled="{Binding HasError}" Margin="0,0,8,0" ToolTip="Dismiss current error condition">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 4 5 H 12 M 5 5 V 13 H 11 V 5 M 7 3 H 9" Stroke="#DC2626" StrokeThickness="1.3" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Clear Error" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Slot 4: Load Audio File -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding BrowseAudioFileCommand}" Margin="0,0,8,0" ToolTip="Select WAV/MP3 file for test playback">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 2 3 H 6 L 8 5 H 14 V 12 H 2 Z" Stroke="#D97706" StrokeThickness="1.3" Fill="Transparent" Width="13" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Load Audio File" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Slot 5: Engine Specs -->
                    <Button Style="{StaticResource ToolbarButton}" Click="EngineSpecsButton_Click" ToolTip="View engine transport specifications">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 7 2 A 5 5 0 1 0 7 12 A 5 5 0 1 0 7 2 M 7 5 V 8 M 7 10 V 10.5" Stroke="#475569" StrokeThickness="1.4" Width="13" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Engine Specs" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Quick Session State Pill (Right) -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                        Background="{Binding Snapshot.State, Converter={StaticResource StatusBgConv}}"
                        BorderBrush="{Binding Snapshot.State, Converter={StaticResource StatusBorderConv}}"
                        BorderThickness="1" CornerRadius="2" Padding="8,3">
                    <TextBlock Text="{Binding StateText}" FontWeight="Bold" FontSize="10" 
                               Foreground="{Binding Snapshot.State, Converter={StaticResource StatusFgConv}}" />
                </Border>
            </DockPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: SUBTOOLBAR (48px)                                          -->
        <!-- Action1 (Left: Start/Stop, Mute, Route Mode, Tone) | Selection1 (BT, Host Dev) -->
        <!-- ================================================================= -->
        <Border Grid.Row="1" Background="{StaticResource SubToolbarBgBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268" /> <!-- Action1 Group (Aligned with SideSection) -->
                    <ColumnDefinition Width="*" />   <!-- Selection1 Group (Aligned with MainSection) -->
                </Grid.ColumnDefinitions>

                <!-- Action1: Start/Stop, Mute Mic, Route Mode Switch, Tone -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ActBtn 1: Start / Stop Button (36x36) -->
                    <Grid Width="36" Height="36" Margin="0,0,8,0">
                        <!-- START Button (Visible when CanStart) -->
                        <Button Style="{StaticResource SquareActionButton}" 
                                Command="{Binding StartCommand}" 
                                ToolTip="{Binding StartButtonTooltip}"
                                Background="{StaticResource TechGreenBrush}"
                                BorderBrush="#059669"
                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVisConv}}">
                            <Path Data="M 5 3 L 15 9 L 5 15 Z" Fill="#FFFFFF" Width="14" Height="14" />
                        </Button>

                        <!-- STOP Button (Visible when CanStop) -->
                        <Button Style="{StaticResource SquareActionButton}" 
                                Command="{Binding StopCommand}" 
                                ToolTip="Stop active streaming session"
                                Background="{StaticResource TechRedBrush}"
                                BorderBrush="#DC2626"
                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVisConv}}">
                            <Rectangle Fill="#FFFFFF" Width="12" Height="12" />
                        </Button>
                    </Grid>

                    <!-- ActBtn 2: Mic Mute / Unmute Button (36x36) -->
                    <Button Style="{StaticResource SquareActionButton}" 
                            Command="{Binding ToggleMicCommand}" 
                            Margin="0,0,8,0"
                            ToolTip="{Binding MicMuteButtonText}">
                        <Grid>
                            <!-- UNMUTED Icon (Mic active) -->
                            <Path Data="M 6 1 A 2 2 0 0 0 4 3 V 7 A 2 2 0 0 0 8 7 V 3 A 2 2 0 0 0 6 1 Z M 10 6 V 7 A 4 4 0 0 1 2 7 V 6 H 1 V 7 A 5 5 0 0 0 5.5 11.9 V 14 H 6.5 V 11.9 A 5 5 0 0 0 11 7 V 6 Z" 
                                  Fill="#1E293B" Width="12" Height="14"
                                  Visibility="{Binding IsMicMuted, Converter={StaticResource BoolToVisConv}, ConverterParameter=Inverse}" />

                            <!-- MUTED Icon (Mic muted) -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMicMuted, Converter={StaticResource BoolToVisConv}}">
                                <Path Data="M 1 1 L 11 11 M 6 1 A 2 2 0 0 0 4 3 V 7 M 10 6 V 7 A 4 4 0 0 1 2 7" 
                                      Stroke="#DC2626" StrokeThickness="1.5" Width="12" Height="12" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- ActBtn 3: Route Mode Segmented Switch (IN / OUT) -->
                    <Border Background="#F1F5F9" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="2" Height="36" Margin="0,0,8,0" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- IN Button -->
                            <Button Command="{Binding SetRouteInCommand}" Width="44" Height="30" Margin="0,0,1,0" ToolTip="Host Input Route: Capture PC microphone to bridge">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#64748B" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="1">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRouteIn}" Value="True">
                                                <Setter Property="Background" Value="#1E293B" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="IN" />
                            </Button>

                            <!-- OUT Button -->
                            <Button Command="{Binding SetRouteOutCommand}" Width="44" Height="30" ToolTip="Host Output Route: Direct PC output playback to bridge">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#64748B" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="1">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRouteOut}" Value="True">
                                                <Setter Property="Background" Value="#1E293B" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="OUT" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ActBtn 4: Test Tone Generator Compact Button (36x36) -->
                    <Button Style="{StaticResource SquareActionButton}" 
                            Command="{Binding ToggleTestToneCommand}" 
                            ToolTip="{Binding ToneStatusText}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,0,1">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#94A3B8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToneEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource TechAmberBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="1kHz" FontSize="8" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Selection1: Dropdown 1 (Bluetooth Devices + BT Settings Nav) + Dropdown 2 (Host Audio Endpoint: IN or OUT) -->
                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Dropdown 1: Bluetooth Device List with System Settings Nav -->
                    <DockPanel Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="BT DEV:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" DockPanel.Dock="Left" />
                        <!-- Button nav to Windows Bluetooth Settings -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Command="{Binding OpenBluetoothSettingsCommand}" Margin="4,0,0,0" Height="36" Width="30" Padding="0" ToolTip="Open Windows Bluetooth Settings (ms-settings:bluetooth)">
                            <Path Data="M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 1 0 12 15 M 19.4 15 A 1.65 1.65 0 0 0 19.73 16.82 L 19.8 16.9 A 2 2 0 1 1 17 19.7 L 16.9 19.6 A 1.65 1.65 0 0 0 15 19.4 A 1.65 1.65 0 0 0 13.5 20.9 L 13.5 21 A 2 2 0 1 1 9.5 21 L 9.5 20.9 A 1.65 1.65 0 0 0 8 19.4 A 1.65 1.65 0 0 0 6.18 19.73 L 6.1 19.8 A 2 2 0 1 1 3.3 17 L 3.4 16.9 A 1.65 1.65 0 0 0 3.6 15 A 1.65 1.65 0 0 0 2.1 13.5 L 2 13.5 A 2 2 0 1 1 2 9.5 L 2.1 9.5 A 1.65 1.65 0 0 0 3.6 8 A 1.65 1.65 0 0 0 3.27 6.18 L 3.2 6.1 A 2 2 0 1 1 6 3.3 L 6.1 3.4 A 1.65 1.65 0 0 0 8 3.6 A 1.65 1.65 0 0 0 9.5 2.1 L 9.5 2 A 2 2 0 1 1 13.5 2 L 13.5 2.1 A 1.65 1.65 0 0 0 15 3.6 A 1.65 1.65 0 0 0 16.82 3.27 L 16.9 3.2 A 2 2 0 1 1 19.7 6 L 19.6 6.1 A 1.65 1.65 0 0 0 19.4 8 A 1.65 1.65 0 0 0 20.9 9.5 L 21 9.5 A 2 2 0 1 1 21 13.5 L 20.9 13.5 A 1.65 1.65 0 0 0 19.4 15 Z" 
                                  Stroke="#475569" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <!-- Programmatic Bluetooth Radio Power Button (Always Visible, WinRT Hardware Control) -->
                        <Button DockPanel.Dock="Right" Command="{Binding ToggleBluetoothRadioCommand}"
                                Margin="4,0,0,0" Height="36" Padding="6,0" ToolTip="{Binding BluetoothButtonToolTip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                    <!-- Default OFF State: High-visibility Alert Badge -->
                                    <Setter Property="Background" Value="#FEF2F2" />
                                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBluetoothEnabled}" Value="True">
                                            <!-- ON State: Calm Tech Green / Active Accent -->
                                            <Setter Property="Background" Value="#F0FDF4" />
                                            <Setter Property="BorderBrush" Value="#86EFAC" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOperatingBluetoothRadio}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Bluetooth Glyph Icon -->
                                <Path Width="10" Height="14" Stretch="Uniform" Margin="0,0,4,0" StrokeThickness="1.4">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M 6.5 6.5 L 11.5 11.5 L 6.5 16.5 M 9 2 L 9 22 L 14 17 L 9 12 L 14 7 Z" />
                                            <!-- Default OFF: Red -->
                                            <Setter Property="Stroke" Value="#DC2626" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBluetoothEnabled}" Value="True">
                                                    <!-- ON: Tech Green -->
                                                    <Setter Property="Stroke" Value="#16A34A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!-- Status Text -->
                                <TextBlock FontSize="9" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="TURN ON" />
                                            <Setter Property="Foreground" Value="#DC2626" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBluetoothEnabled}" Value="True">
                                                    <Setter Property="Text" Value="BT ON" />
                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOperatingBluetoothRadio}" Value="True">
                                                    <Setter Property="Text" Value="..." />
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <ComboBox ItemsSource="{Binding BluetoothDevices}" 
                                  SelectedItem="{Binding SelectedBluetoothDevice, Mode=TwoWay}"
                                  Height="36" VerticalContentAlignment="Center" ToolTip="Select paired Bluetooth device for audio bridge">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{Binding CanSelectForBridge}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6" />
                                            <Setter Property="ToolTip" Value="Device is offline or incompatible. Connect in Windows Settings first." />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <!-- Right: Status Badge -->
                                        <Border CornerRadius="2" Padding="4,1" Margin="4,0,0,0" DockPanel.Dock="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Default: Offline (Gray) -->
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <!-- Bridge Ready: Green -->
                                                        <DataTrigger Binding="{Binding IsBridgeReady}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource TechGreenBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource TechGreenBorderBrush}" />
                                                        </DataTrigger>
                                                        <!-- Incompatible A2DP: Red tint -->
                                                        <DataTrigger Binding="{Binding IsHfpSupported}" Value="False">
                                                            <Setter Property="Background" Value="#FEF2F2" />
                                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding BridgeSupportStatus}" FontSize="8" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBridgeReady}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TechGreenBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHfpSupported}" Value="False">
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Left: Category Badge -->
                                        <Border CornerRadius="2" Padding="3,1" Margin="0,0,6,0" DockPanel.Dock="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Default / Other -->
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CategoryText}" Value="PHONE">
                                                            <Setter Property="Background" Value="#EEF2FF" />
                                                            <Setter Property="BorderBrush" Value="#C7D2FE" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CategoryText}" Value="HEADSET">
                                                            <Setter Property="Background" Value="#F0FDF4" />
                                                            <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CategoryText}" Value="SPEAKER">
                                                            <Setter Property="Background" Value="#FFF7ED" />
                                                            <Setter Property="BorderBrush" Value="#FED7AA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CategoryText}" FontSize="8" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CategoryText}" Value="PHONE">
                                                                <Setter Property="Foreground" Value="#4338CA" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CategoryText}" Value="HEADSET">
                                                                <Setter Property="Foreground" Value="#15803D" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CategoryText}" Value="SPEAKER">
                                                                <Setter Property="Foreground" Value="#C2410C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Center: Device Name -->
                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <!-- Dropdown 2: Adaptive Host Endpoint (IN: Mic or OUT: Speaker depending on Route Mode) -->
                    <DockPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Dropdown2Label}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" DockPanel.Dock="Left" />
                        <ComboBox ItemsSource="{Binding AvailableEndpointDevices}" 
                                  SelectedItem="{Binding SelectedEndpointDevice, Mode=TwoWay}"
                                  Height="36" VerticalContentAlignment="Center" ToolTip="Select host audio device for bridge route (Resets to None on IN/OUT switch)">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="3,1" Margin="4,0,0,0" DockPanel.Dock="Right" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisConv}}">
                                            <TextBlock Text="DEF" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 2: BODY (Flex *, ~528px at standard height)                   -->
        <!-- SideSection (268px: Diagnostics & State) | MainSection (Monitoring)-->
        <!-- ================================================================= -->
        <Grid Grid.Row="2" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" /> <!-- SideSection -->
                <ColumnDefinition Width="*" />   <!-- MainSection -->
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- LEFT COLUMN: SideSection (268px)                              -->
            <!-- ============================================================= -->
            <Border Grid.Column="0" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <StackPanel>
                        <!-- Card 1: Session Status & Interlock -->
                        <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="SESSION HEALTH" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" Margin="0" />
                                    <Border Background="{Binding Snapshot.State, Converter={StaticResource StatusBgConv}}" 
                                            BorderBrush="{Binding Snapshot.State, Converter={StaticResource StatusBorderConv}}" 
                                            BorderThickness="1" CornerRadius="1" Padding="6,1" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding StateText}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{Binding Snapshot.State, Converter={StaticResource StatusFgConv}}" />
                                    </Border>
                                </DockPanel>

                                <!-- Safety Interlock Indicator -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="6,4">
                                    <TextBlock Text="{Binding SafetyInterlockStatusText}" FontSize="9" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Pre-Flight Diagnostics Checklist -->
                        <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <TextBlock Text="PRE-FLIGHT DIAGNOSTICS" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" Margin="0" />
                                    <Border Background="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusBgConv}}" 
                                            BorderBrush="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusBorderConv}}" 
                                            BorderThickness="1" CornerRadius="1" Padding="6,1" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding PreflightBadgeText}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{Binding Snapshot.PreflightOverall, Converter={StaticResource StatusFgConv}}" />
                                    </Border>
                                </DockPanel>

                                <!-- Items List -->
                                <ItemsControl ItemsSource="{Binding Snapshot.PreflightItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}" 
                                                    Background="{Binding Status, Converter={StaticResource StatusBgConv}}" 
                                                    BorderThickness="1" CornerRadius="1" Padding="6" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="10" 
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" 
                                                                   DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                        <Border Background="{StaticResource SurfaceBrush}"
                                                                BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}"
                                                                BorderThickness="1" CornerRadius="1" Padding="4,1" DockPanel.Dock="Right">
                                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="8" 
                                                                       Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" />
                                                        </Border>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding Details}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" 
                                                               Margin="0,3,0,0" TextWrapping="Wrap" />

                                                    <!-- Remediation Guidance Callout -->
                                                    <Border Background="{StaticResource SurfaceBrush}" 
                                                            BorderBrush="{Binding Status, Converter={StaticResource StatusBorderConv}}" 
                                                            BorderThickness="1" CornerRadius="1" Padding="5,3" Margin="0,4,0,0"
                                                            Visibility="{Binding Status, Converter={StaticResource StatusToRemediationVisConv}}">
                                                        <StackPanel>
                                                            <TextBlock Text="REMEDIATION:" FontWeight="Bold" FontSize="8" Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}" />
                                                            <TextBlock Text="{Binding RemediationText}" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Selected Endpoints Footprint -->
                        <Border Style="{StaticResource EngineeringCard}" Padding="10">
                            <StackPanel>
                                <TextBlock Text="ENDPOINT FOOTPRINT" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                                <TextBlock Text="Target Render ID:" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedRenderDeviceId, TargetNullValue='None Selected'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,4" />

                                <TextBlock Text="Capture Source ID:" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedCaptureDeviceId, TargetNullValue='None Selected'}" FontSize="9" FontFamily="Consolas, monospace" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================================= -->
            <!-- RIGHT COLUMN: MainSection (Flexible width, min 444px)         -->
            <!-- Audio VU Meters, Channel Faders, Telemetry Metrics           -->
            <!-- ============================================================= -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                    <StackPanel>
                        <!-- Error Alert Banner (Visible when HasError) -->
                        <Border Background="{StaticResource TechRedBgBrush}" BorderBrush="{StaticResource TechRedBorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8" Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVisConv}}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="DISMISS" Command="{Binding ClearErrorCommand}" Style="{StaticResource ToolbarButton}" Height="22" Padding="6,1" FontSize="9" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ENGINE FAILURE DETECTED" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TechRedBrush}" />
                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="9" Foreground="#991B1B" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Card 1: High-Precision Real-time Audio VU Meters -->
                        <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,10" Padding="12">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <TextBlock Text="REAL-TIME AUDIO MONITOR (30Hz Polling)" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" Margin="0" />
                                    <TextBlock Text="PEAK / RMS METERS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Input Peak Meter -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="INPUT (Capture Mic)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <!-- Clip Indicator LED -->
                                            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E2E8F0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInputClipping}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource TechRedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding InputPeakDbText}" FontSize="10" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{Binding InputMeterBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Grid.Row="1" Style="{StaticResource EngineeringProgressBar}" 
                                                 Value="{Binding InputPeakPercent, Mode=OneWay}" 
                                                 Foreground="{Binding InputMeterBrush}" />
                                </Grid>

                                <!-- Output Peak Meter -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="OUTPUT (Render Endpoint)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <!-- Clip Indicator LED -->
                                            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E2E8F0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutputClipping}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource TechRedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding OutputPeakDbText}" FontSize="10" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{Binding OutputMeterBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Grid.Row="1" Style="{StaticResource EngineeringProgressBar}" 
                                                 Value="{Binding OutputPeakPercent, Mode=OneWay}" 
                                                 Foreground="{Binding OutputMeterBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Audio Source Channels & Gain Faders -->
                        <Border Style="{StaticResource EngineeringCard}" Margin="0,0,0,10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="SOURCE CHANNELS &amp; GAIN FADERS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />

                                <!-- Channel 1: Microphone Source -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="MIC CHANNEL" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding MicStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="4.0" Value="{Binding MicGain, Mode=TwoWay}" 
                                                VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding MicGainText}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="11" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Channel 2: 1000 Hz Sine Wave Test Tone -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="TEST SINE TONE" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="1000 Hz, -12 dBFS" FontSize="8" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding ToneGain, Mode=TwoWay}" 
                                                VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ToneGainText}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="11" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Channel 3: Audio File Playback -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="FILE PLAYBACK" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding AudioFileStatusText}" FontSize="8" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding FileGain, Mode=TwoWay}" 
                                                VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding FileGainText}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="11" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Engineering Telemetry & Buffer Health -->
                        <Border Style="{StaticResource EngineeringCard}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="ENGINEERING TELEMETRY &amp; SPECS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <UniformGrid Columns="2" Rows="2">
                                    <!-- Tile 1 -->
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8,6" Margin="0,0,4,4">
                                        <StackPanel>
                                            <TextBlock Text="TARGET AUDIO FORMAT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="16,000 Hz • 16-bit Mono" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Tile 2 -->
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8,6" Margin="4,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="RINGBUFFER LATENCY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="~12 - 20 ms Target" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TechGreenBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Tile 3 -->
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8,6" Margin="0,4,4,0">
                                        <StackPanel>
                                            <TextBlock Text="BUFFER HEALTH" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="0 Underflows • 0 Overflows" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Tile 4 -->
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="8,6" Margin="4,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DELIVERY INTEGRITY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="Unverified (No Companion)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TechAmberBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 3: STATUSBAR (32px)                                           -->
        <!-- Truthful Status 3-Tier Architecture: Endpoint, Bluetooth, Delivery-->
        <!-- ================================================================= -->
        <Border Grid.Row="3" Background="{StaticResource SubToolbarBgBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /> <!-- Text 1: Endpoint Status -->
                    <ColumnDefinition Width="*" /> <!-- Text 2: Bluetooth Status -->
                    <ColumnDefinition Width="*" /> <!-- Text 3: Delivery Status -->
                </Grid.ColumnDefinitions>

                <!-- Text 1: Endpoint Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource TechGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Endpoint: " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EndpointStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Text 2: Bluetooth HFP Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource TechAmberBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Bluetooth: " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BluetoothStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Text 3: Delivery Confirmation Status (Truthful Display) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Ellipse Width="6" Height="6" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Delivery: " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DeliveryStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
