<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Service Running Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_stopped"
        android:textSize="15sp"
        android:textColor="@color/teal_700"
        android:layout_marginBottom="4dp" />

    <!-- Bluetooth Bridge Link Status -->
    <TextView
        android:id="@+id/tvBridgeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● Bluetooth Bridge: DISCONNECTED"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FF5252"
        android:layout_marginBottom="4dp" />

    <!-- Host Device Info -->
    <TextView
        android:id="@+id/tvHostDevice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Windows Host: Chưa ghép nối / chưa kết nối"
        android:textSize="13sp"
        android:textColor="#757575"
        android:layout_marginBottom="12dp" />

    <!-- Audio Route Status -->
    <TextView
        android:id="@+id/tvRoute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Route: DEFAULT"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Service Toggle Button -->
    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_start_service"
        android:layout_marginBottom="20dp" />

    <!-- Route Controls -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Audio Route Control"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnSpeaker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_force_speaker"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnEarpiece"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_force_earpiece"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnBluetooth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_reset_bluetooth"
        android:layout_marginBottom="8dp" />

</LinearLayout>
